                      "cardId": "cp9cvyy8z",
                      "schemaVersion": 2.1,
                      "markdown": "<style>\n\n/* Layout for the row of cards */\n.cards-list {\n  display: flex;\n  justify-content: center;\n  gap: 75px;\n  flex-wrap: wrap;\n}\n\n/* Each card container */\n.card-container {\n  background-color: #ffffff;\n  border-radius: 14px;\n  width: 200px;\n  min-height: 90px;\n  border: 1px solid rgba(0,0,0,0.08);\n  margin: 0;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  justify-content: center;\n  padding: 12px;\n  box-sizing: border-box;\n  transition: all 0.2s ease;\n}\n\n/* Hover effect on the white card */\n.card-container:hover {\n  background-color: rgba(240, 240, 240, 0.6);\n  transform: translateY(-4px);\n  box-shadow: 0 8px 18px rgba(0,0,0,0.15);\n}\n\n/* Link inside the card */\n.card-link {\n  display: block;\n  text-align: center;\n  color: #13294B !important;\n  text-decoration: none !important;\n}\n.card-link:focus,\n.card-link:hover,\n.card-link:active {\n  outline: none !important;\n  border: none !important;\n  box-shadow: none !important;\n}\n\n/* Label text */\n.card-label {\n  font-weight: 700;\n  font-size: 17px;\n  margin-top: 8px;\n  color: #13294B !important;\n  outline: none !important;\n  border: none !important;\n}\n\n/* Prevent icons from shifting on hover */\n.icon {\n  display: block;\n  margin: 10px auto 0 auto;\n}\n\n</style>\n\n\n<div class=\"cards-list\">\n\n  <!-- CARD 1 -->\n  <div class=\"card-container\">\n <a class=\"card-link\" href=\"#about-section\">\n    <span class=\"card-label\">How to use this dashboard</span>\n  </a>\n  </div>\n\n  <!-- CARD 2 -->\n  <div class=\"card-container\">\n <a class=\"card-link\" href=\"#accessibility\">\n    <span class=\"card-label\">Request accessibility help</span>\n  </a>\n  </div>\n\n  <!-- CARD 3 -->\n  <div class=\"card-container\">\n <a class=\"card-link\" target=\"_blank\" rel=\"noopener\" aria-label=\"Minneapolis Neighborhood Housing dashboard\" href=\"https://tableau.minneapolismn.gov/views/MinneapolisNeighbor