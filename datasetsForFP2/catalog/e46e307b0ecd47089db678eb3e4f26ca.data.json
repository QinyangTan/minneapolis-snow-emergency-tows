                  "settings": {
                    "cardId": "ccdirwhbu",
                    "schemaVersion": 2.1,
                    "markdown": "<style>\n  :root{\n    --btn-bg: #55437E;\n    --btn-border: #114681;\n    --btn-active: #114681;\n    --ring-gap-color: #ecedef;          /* set to your page background */\n    --ring-color: rgba(0, 138, 192, .55);\n  }\n  \n    /* One wrapper for all three buttons */\n  .button-row{\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 12px;\n    align-items: stretch;               /* all cells match tallest item */\n    padding: 0.5rem;\n  }\n  \n   /* Each cell stretches; button fills it */\n  .button-cell{\n    display: flex;                      /* ensures child can stretch */\n  }\n  \n  .custom-button{\n    width: 100%;\n    height: 100%;                       /* fill stretched cell height */\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: clamp(8px, 1.2vw, 14px);\n    \n    /* Responsive sizing */\n    padding: clamp(8px, 2vw, 14px) clamp(14px, 3vw, 28px); \n    font-size: clamp(10px, 1.4vw, 18px);               \n    line-height: 0.6;                                                \n    \n    font-weight: 700;\n    color: #fff;\n    background-color: var(--btn-bg);\n    text-decoration: none;\n    \n    border-radius: 7px;                                          /* 8px;*/\n    border: 2px solid var(--btn-border);\n    transition: background-color 0.2s ease, transform 0.05s ease, box-shadow 0.2s ease;\n\n    /* Helps long text behave nicely */\n    text-align: center;\n    max-width: 100%;\n    white-space: normal;\n    word-break: break-word;\n  }\n  \n  /* Optional: keep text styling consistent when SVG exists */\n  .custom-button .btn-text{\n    display: inline-block;\n  }\n  /* SVG scales with text size */\n  .custom-button .btn-icon{\n    height: 1.15em;\n    width: auto;\n    display: block;\n    flex-shrink: 0;\n    transform: translateY(0.02em);\n  }\n  .custom-button .btn-icon path{\n    fill: #fff;\n  }\n\n  /* Hover/focus ring with a visible gap */\n  .custom-button:hover,\n  .custom-button:focus-visible{\n    box-shadow:\n      0 0 0 2px var(--ring-gap-color),\n      0 0 0 4px var(--ring-color);\n    outline: none;\n  }\n  \n  /* Pressed state */\n  .custom-button:active{\n    background-color: var(--btn-active);\n    transform: translateY(1px);\n  }\n\n  /* Stack on iPad landscape (1024px) and below */\n  @media (max-width: 1024px){\n    .button-row{\n      grid-template-columns: 1fr;\n    }\n  }\n\n  /* Optional: make buttons easier to tap on very small screens */\n  @media (max-width: 480px){\n    .custom-button{\n      min-height: 3.1em; /* ensures comfortable tap target */\n    }\n  }\n</style>\n\n<div class=\"button-row\">\n\n  <div class=\"button-cell\">\n    <a class=\"custom-button\" href=\"#about-section\">\n      How to use this dashboard\n    </a>\n  </div>\n\n  <div class=\"button-cell\">\n    <a class=\"custom-button\" href=\"#accessibility\">\n      Request accessibility help\n    </a>\n  </div>\n\n  <div class=\"button-cell\">\n    <a class=\"custom-button\" rel=\"noopener noreferrer\" href=\"\">\n      <span class=\"btn-text\">View dashboard in full screen</span>\n      <svg class='btn-icon' viewBox='0 0 640 640' xmlns='http://www.w3.org/2000/svg' aria-hidden='true' focusable='false'>\n        <path d='M384 64C366.3 64 352 78.3 352 96C352 113.7 366.3 128 384 128L466.7 128L265.3 329.4C252.8 341.9 252.8 362.2 265.3 374.7C277.8 387.2 298.1 387.2 310.6 374.7L512 173.3L512 256C512 273.7 526.3 288 544 288C561.7 288 576 273.7 576 256L576 96C576 78.3 561.7 64 544 64L384 64zM144 160C99.8 160 64 195.8 64 240L64 496C64 540.2 99.8 576 144 576L400 576C444.2 576 480 540.2 480 496L480 416C480 398.3 465.7 384 448 384C430.3 384 416 398.3 416 416L416 496C416 504.8 408.8 512 400 512L144 512C135.2 512 128 504.8 128 496L128 240C128 231.2 135.2 224 144 224L224 224C241.7 224 256 209.7 256 192C256 174.3 241.7 160 224 160L144 160z' />\n      </svg>\n    </a>\n  </div>\n\n</div>\n\n"
