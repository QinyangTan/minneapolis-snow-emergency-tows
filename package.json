{
  "name": "minneapolis-snow-emergency-tows",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "qa:browser": "playwright test",
    "demo:gifs": "node scripts/record-demos.mjs",
    "qa:research": "node --test tests/test_event_analysis.mjs tests/test_comparison_evidence.mjs tests/test_event_constellation.mjs tests/test_constellation_brush.mjs tests/test_evaluate_study.mjs tests/test_study_answer_key.mjs",
    "build:pages": "PAGES_BASE_PATH=/minneapolis-snow-emergency-tows-demo npm run build",
    "qa:pages": "node scripts/check-pages-build.mjs",
    "demo:winter-gifs": "node scripts/record-winter-demos.mjs",
    "qa:evaluation": "node --test tests/test_evaluate_study.mjs tests/test_study_answer_key.mjs",
    "evaluation:report": "node scripts/evaluate-study.mjs",
    "build:extension": "node scripts/build-google-maps-extension.mjs",
    "qa:extension": "node --test tests/test_google_maps_extension.mjs tests/test_extension_story_layers.mjs tests/test_extension_delta_layer.mjs",
    "qa:extension:browser": "node scripts/test-google-maps-extension-browser.mjs",
    "qa:extension:live": "node scripts/test-google-maps-extension-live.mjs",
    "data:fp2": "python scripts/prepare-fp2.py && node scripts/prepare-fp2-geography.mjs && node scripts/analyze-fp2.mjs",
    "qa:fp2": "node --test tests/test_fp2.mjs"
  },
  "dependencies": {
    "@sveltejs/kit": "^2.20.0",
    "d3-geo": "^3.1.1",
    "svelte": "^5.20.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/d3-geo": "^3.1.0",
    "svelte-check": "^4.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.2",
    "@playwright/test": "^1.55.0",
    "@axe-core/playwright": "^4.10.0",
    "ffmpeg-static": "^5.2.0"
  }
}
